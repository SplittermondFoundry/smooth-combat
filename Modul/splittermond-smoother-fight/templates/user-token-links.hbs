<form class="sf-settings-form">
    <p class="notes">{{localize "SMOOTHER_FIGHT.Settings.LinksHint"}}</p>

    <section class="sf-primary-gm-setting">
        <label for="smoother-fight-primary-gm">{{localize "SMOOTHER_FIGHT.Settings.PrimaryGm"}}</label>
        <select id="smoother-fight-primary-gm" data-role="primary-gm">
            <option value="">{{localize "SMOOTHER_FIGHT.Settings.NoPrimaryGm"}}</option>
            {{#each gms}}
                <option value="{{this.id}}" {{#if this.selected}}selected{{/if}}>{{this.name}}</option>
            {{/each}}
        </select>
        <p class="notes">{{localize "SMOOTHER_FIGHT.Settings.PrimaryGmHint"}}</p>
    </section>

    <div class="sf-settings-list">
        <section class="sf-sheet-assignments">
            <h3><i class="fa-solid fa-address-card"></i> {{localize "SMOOTHER_FIGHT.Settings.SheetAssignments"}}</h3>
            <p class="notes">{{localize "SMOOTHER_FIGHT.Settings.SheetAssignmentsHint"}}</p>
            <label class="sf-sheet-search">
                <i class="fa-solid fa-magnifying-glass"></i>
                <input type="search" data-role="actor-search" placeholder="{{localize "SMOOTHER_FIGHT.Settings.SearchSheets"}}" autocomplete="off">
            </label>
            <div class="sf-sheet-assignment-groups">
                {{#each actorGroups}}
                    {{#if this.count}}
                        <details class="sf-actor-group" data-actor-group="{{this.id}}" {{#if this.open}}open{{/if}}>
                            <summary>
                                <span><i class="{{this.icon}}"></i> {{this.label}}</span>
                                <span class="sf-actor-group-meta">
                                    <span data-role="actor-group-count">{{this.count}}</span>
                                    <i class="fa-solid fa-chevron-down"></i>
                                </span>
                            </summary>
                            <div class="sf-sheet-assignment-list">
                                {{#each this.actors}}
                                    <label class="sf-sheet-assignment-row" data-actor-row data-search="{{this.name}}">
                                        <img src="{{this.img}}" alt="">
                                        <span>
                                            <strong>{{this.name}}</strong>
                                            <small>{{this.typeLabel}}</small>
                                        </span>
                                        <select data-actor-uuid="{{this.uuid}}">
                                            <option value="">{{localize "SMOOTHER_FIGHT.Settings.NoSheetAssignment"}}</option>
                                            {{#each this.users}}
                                                <option value="{{this.id}}" {{#if this.selected}}selected{{/if}}>{{this.name}}{{#if this.isGM}} (GM){{/if}}</option>
                                            {{/each}}
                                        </select>
                                    </label>
                                {{/each}}
                            </div>
                        </details>
                    {{/if}}
                {{/each}}
                <p class="notification warning" data-role="no-actor-search-results" hidden>{{localize "SMOOTHER_FIGHT.Settings.NoSearchResults"}}</p>
                {{#unless hasActors}}
                    <p class="notification warning">{{localize "SMOOTHER_FIGHT.Settings.NoSheets"}}</p>
                {{/unless}}
            </div>
        </section>

        <h3 class="sf-token-assignment-heading"><i class="fa-solid fa-chess-pawn"></i> {{localize "SMOOTHER_FIGHT.Settings.TokenAssignments"}}</h3>
        <p class="notes">{{localize "SMOOTHER_FIGHT.Settings.TokenAssignmentsHint"}}</p>
        {{#each users}}
            <fieldset class="sf-settings-row">
                <span class="sf-settings-user">
                    <span class="sf-user-dot {{#if this.active}}is-online{{/if}}"></span>
                    {{this.name}}
                    {{#if this.isGM}}<small>GM</small>{{/if}}
                </span>
                <span class="sf-settings-tokens">
                    {{#each this.tokens}}
                        <label>
                            <input type="checkbox" data-user-id="{{../id}}" data-token-uuid="{{this.uuid}}" data-actor-uuid="{{this.actorUuid}}" value="{{this.uuid}}" {{#if this.selected}}checked{{/if}} {{#if this.inherited}}data-inherited="true"{{/if}} {{#if this.automatic}}data-automatic="true"{{/if}}>
                            <span>{{this.label}}</span>
                        </label>
                    {{/each}}
                    {{#unless this.tokens.length}}<small>{{localize "SMOOTHER_FIGHT.Settings.Automatic"}}</small>{{/unless}}
                </span>
            </fieldset>
        {{/each}}
    </div>

    {{#unless hasTokens}}
        <p class="notification warning">{{localize "SMOOTHER_FIGHT.Settings.NoTokens"}}</p>
    {{/unless}}

    <footer class="form-footer">
        <button type="button" data-action="save-links">
            <i class="fa-solid fa-floppy-disk"></i>
            {{localize "SMOOTHER_FIGHT.Settings.Save"}}
        </button>
    </footer>
</form>
